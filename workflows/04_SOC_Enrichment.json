      "parameters": {
        "jsCode": "// AttachRelatedTI \u2014 merge cached verdicts for related IPs (no new quota)\nconst main = $('TIMerge').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r && r.indicator);\nconst related_ti = rows.map(r => {\n  let res = r.result;\n  if (typeof res === 'string') { try { res = JSON.parse(res); } catch (e) { res = null; } }\n  let v = 'UNKNOWN';\n  try { const s = res.data.attributes.last_analysis_stats; v = { malicious: s.malicious || 0, suspicious: s.suspicious || 0 }; } catch (e) {}\n  return { indicator: r.indicator, virustotal: v };\n});\nreturn [{ json: Object.assign({}, main, { related_ti: related_ti }) }];"

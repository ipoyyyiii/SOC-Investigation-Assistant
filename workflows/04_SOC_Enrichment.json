    {
      "id": "ti-mg-61315274",
      "name": "TIMerge",
      "type": "n8n-nodes-base.code",
      "position": [
        3456,
        -224
      ],
      "parameters": {
        "jsCode": "// TIMerge \u2014 cache-aware TI (fresh ?? cached ?? UNKNOWN)\nconst ctx = $('EnrichmentTrigger').first().json;\nconst rows = {};\ntry { $('TICacheRead').all().forEach(i => { rows[i.json.source] = i.json; }); } catch (e) {}\nfunction pick(nodeName, source) {\n  try {\n    const j = $(nodeName).first().json;\n    if (j && j.data) return { v: j, from: 'live', at: new Date().toISOString() };\n  } catch (e) {}\n  try {\n    const r = rows[source];\n    if (r && r.result) return { v: r.result, from: 'cache', at: r.fetched_at };\n  } catch (e) {}\n  return { v: null, from: 'none', at: null };\n}\nfunction vtStats(body) { try { const s = body.data.attributes.last_analysis_stats; return { malicious: s.malicious || 0, suspicious: s.suspicious || 0, harmless: s.harmless || 0 }; } catch (e) { return 'UNKNOWN'; } }\nfunction abStats(body) { try { const d = body.data; return { confidence: d.abuseConfidenceScore, country: d.countryCode, reports: d.totalReports }; } catch (e) { return 'UNKNOWN'; } }\n\nfunction pickRaw(nodeName, source, probe) {\n  try { const j = $(nodeName).first().json; if (j && !j.error && (probe(j))) return { v: j, from: 'live' }; } catch (e) {}\n  try { const r = rows[source]; if (r && r.result && probe(r.result)) return { v: r.result, from: 'cache' }; } catch (e) {}\n  return { v: null, from: 'none' };\n}\nfunction urlhausInfo(b) { try { return { url_status: (b || {}).url_status || 'unknown', query_status: (b || {}).query_status || 'unknown' }; } catch (e) { return 'UNKNOWN'; } }\nfunction otxInfo(b) { try { return { pulses: (((b || {}).pulse_info || {}).count) || 0 }; } catch (e) { return 'UNKNOWN'; } }\nconst p_urlhaus = pickRaw('TI_URLhaus', 'urlhaus', function (j) { return j.query_status; });\nconst p_otx = pickRaw('TI_OTX', 'otx_ip', function (j) { return j.pulse_info || j.base_indicator; });\nconst p_ip = pick('TI_VirusTotal', 'virustotal_ip');\nconst p_ab = pick('TI_AbuseIPDB', 'abuseipdb');\nconst p_vf = pick('TI_VTFile', 'virustotal_file');\nconst p_u = pick('TI_URL', 'virustotal_url');\nconst vtInfo = vtStats(p_ip.v), abInfo = abStats(p_ab.v), vfInfo = vtStats(p_vf.v), urlInfo = vtStats(p_u.v);\nconst ti = [{ indicator: ctx.src_ip, type: 'ipv4', sources: { virustotal: vtInfo, abuseipdb: abInfo, otx: otxInfo(p_otx.v) }, cached: (p_ip.from === 'cache' || p_ab.from === 'cache'), checked_at: new Date().toISOString() }];\nconst _h = ((ctx.observables || {}).hash) || '';\nif (_h) ti.push({ indicator: _h, type: 'file_hash', sources: { virustotal: vfInfo }, cached: (p_vf.from === 'cache'), checked_at: p_vf.at || new Date().toISOString() });\nconst _urls = (((ctx.observables || {}).urls) || []);\nif (_urls.length) ti.push({ indicator: _urls[0], type: 'url', sources: { virustotal: urlInfo, urlhaus: urlhausInfo(p_urlhaus.v) }, cached: (p_u.from === 'cache'), checked_at: p_u.at || new Date().toISOString() });\nreturn [{ json: Object.assign({}, ctx, { threat_intel: ti }) }];"
      },
      "typeVersion": 2
    },

      "parameters": {
        "jsCode": "const b = ($('Webhook').first().json.body) || ($('Webhook').first().json);\nconst _ts = Number((($('Webhook').first().json.headers) || {})['x-analyst-ts'] || 0);\nif (!(_ts > 0) || Math.abs(Date.now() / 1000 - _ts) > 300) throw new Error('stale decision (possible replay)');\nconst v = String(b.verdict || '').toUpperCase();\nif (!b.incident_id) throw new Error('incident_id required');\nif (!['TP','FP','ESCALATE'].includes(v)) throw new Error('verdict must be TP|FP|ESCALATE, got: ' + b.verdict);\nconst _who = (() => { try { return $('QAuthAnalyst').first().json.analyst; } catch (e) { return null; } })();\nif (!_who) throw new Error('analyst required');\nif (!b.analyst || String(b.analyst).trim() === '') throw new Error('analyst required');\nreturn [{ json: { incident_id: String(b.incident_id).replace(/'/g, \"''\"), verdict: v, analyst: _who, note: String(b.note || '').replace(/'/g, \"''\") } }];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "1a73dd85-3a32-4dd4-8c01-d35cd7620935",
      "name": "Decide",
      "type": "n8n-nodes-base.postgres",
      "position": [
        160,
        0
      ],
      "parameters": {
        "query": "UPDATE incidents SET status = '{{ $json.verdict }}', analyst_note = '{{ $json.note }}', updated_at = NOW() WHERE incident_id = '{{ $json.incident_id }}'; INSERT INTO analyst_decisions(incident_id, verdict, analyst, note) VALUES ('{{ $json.incident_id }}', '{{ $json.verdict }}', '{{ $json.analyst }}', '{{ $json.note }}');",
        "options": {},
        "operation": "executeQuery"
      },
      "credentials": {

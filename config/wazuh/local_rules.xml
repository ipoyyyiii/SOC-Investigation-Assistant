<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>

<group name="local,malware,">
  <rule id="100010" level="12">
    <decoded_as>clamav-scan</decoded_as>
    <description>Malware detected by ClamAV.</description>
    <group>malware,yara,</group>
    <mitre><id>T1204.002</id></mitre>
  </rule>
</group>

<group name="local,web,">
  <rule id="100011" level="10">
    <if_sid>31100</if_sid>
    <match>cmd=</match>
    <description>Possible webshell command execution.</description>
    <group>web,attack,</group>
    <mitre><id>T1505.003</id></mitre>
  </rule>
</group>

<group name="local,phishing,web,">
  <rule id="100012" level="10">
    <if_sid>31100</if_sid>
    <match>phish/track</match>
    <description>Phishing link clicked by user.</description>
    <group>phishing,web,attack,</group>
    <mitre><id>T1566.002</id></mitre>
  </rule>
</group>

<group name="local,webattack,">
  <rule id="100013" level="10">
    <if_sid>31100</if_sid>
    <match><match>union select|union%20select|%27%20or%20|%27%20OR%20|' or '|or 1=1|1%3D1|information_schema|sleep\(|benchmark\(</match></match>
    <description>SQL injection attempt in web request.</description>
    <group>web,attack,</group>
    <mitre><id>T1190</id></mitre>
  </rule>
  <rule id="100014" level="10">
    <if_sid>31100</if_sid>
    <match>\.\./\.\./|%2e%2e%2f|/etc/passwd|/etc/shadow|boot.ini</match>
    <description>Local file inclusion / path traversal attempt.</description>
    <group>web,attack,</group>
    <mitre><id>T1190</id></mitre>
  </rule>
  <rule id="100015" level="10">
    <if_sid>31100</if_sid>
    <match>;cat |;cat%20|%3bcat|;id|%3bid|;whoami|;ls|&&|/bin/sh|;ping </match>
    <description>Command injection attempt in web request.</description>
    <group>web,attack,</group>
    <mitre><id>T1190</id></mitre>
  </rule>
</group>

<group name="local,suricata,c2,">
  <rule id="100016" level="10">
    <match>SOC LAB C2 beacon callback</match>
    <description>Suricata detected C2 beacon callback pattern.</description>
    <group>suricata,c2,attack,</group>
    <mitre><id>T1071</id></mitre>
  </rule>
</group>

<group name="local,winlab,">
  <rule id="100021" level="10">
    <if_sid>60122</if_sid>
    <description>WINLAB: logon failure 4625 (elevated)</description>
    <group>windows,authentication_failed,attack,</group>
    <mitre><id>T1110</id></mitre>
  </rule>
  <rule id="100022" level="10">
    <if_sid>60106</if_sid>
    <description>WINLAB: Windows logon success (elevated)</description>
    <group>windows,authentication_success,</group>
    <mitre><id>T1078</id></mitre>
  </rule>
  <rule id="100023" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(-enc|-encodedcommand|downloadstring|invoke-expression|iex\(|frombase64string|-nop -w hidden)</field>
    <description>WINLAB: suspicious PowerShell command line</description>
    <group>windows,powershell,attack,</group>
    <mitre><id>T1059.001</id></mitre>
  </rule>
  <rule id="100024" level="10">
    <if_sid>61138</if_sid>
    <description>WINLAB: new service installed (lateral pattern)</description>
    <group>windows,lateral,attack,</group>
    <mitre><id>T1543.003</id></mitre>
  </rule>
  <rule id="100025" level="10">
    <field name="win.system.eventID">^4625$</field>
    <description>WINLAB: duplicate 4625 tap (Sysmon/EK)</description>
    <group>windows,authentication_failed,</group>
  </rule>
</group>

<group name="local,winlab-ad,">
  <rule id="100026" level="10">
    <if_sid>100022</if_sid>
    <field name="win.system.eventID">^4769$</field>
    <field name="win.eventdata.ticketOptions">^0x40810000$</field>
    <description>WINLAB: Kerberoast - suspicious service-ticket request (0x40810000)</description>
    <group>windows,kerberos,attack,</group>
    <mitre><id>T1558.003</id></mitre>
  </rule>
  <rule id="100027" level="10">
    <if_sid>100022</if_sid>
    <field name="win.system.eventID">^4768$</field>
    <field name="win.eventdata.ticketEncryptionType">^0x17$</field>
    <description>WINLAB: AS-REP roast - RC4 TGT request</description>
    <group>windows,kerberos,attack,</group>
    <mitre><id>T1558.004</id></mitre>
  </rule>
  <rule id="100028" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(vssadmin|ntds\.dit|lsass\.dmp|procdump|comsvcs\.dll.*minidump)</field>
    <description>WINLAB: credential dump attempt (NTDS/LSASS/shadow copy)</description>
    <group>windows,credential-access,attack,</group>
    <mitre><id>T1003.003</id></mitre>
  </rule>
</group>

<group name="local,suricata,dns-exfil,">
  <rule id="100017" level="10">
    <match>suspicious DNS exfil pattern</match>
    <description>Suricata detected DNS exfiltration pattern.</description>
    <group>suricata,dns,attack,</group>
    <mitre><id>T1048.003</id></mitre>
  </rule>
  <rule id="100018" level="7">
    <match>high-entropy DNS label</match>
    <description>Suricata detected high-entropy DNS label (tunneling).</description>
    <group>suricata,dns,</group>
    <mitre><id>T1071.004</id></mitre>
  </rule>
</group>
